{
  "name": "@goodandready/dsh-plugin-notify",
  "version": "0.3.6",
  "description": "DSH plugin: audio chimes, cross-session toasts, desktop push, IM webhooks, and web push (PWA) for turn completion, errors, and approvals.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "pretest": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.3",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.8 <0.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "web-push": "^3.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-plugin-notify.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-plugin-notify#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-plugin-notify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "GooDAnDReaDY <support@goodandready.app>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "webhooks",
    "desktop-push",
    "web-push",
    "pwa",
    "audio-chimes",
    "toasts"
  ]
}
